  call void @llvm.amdgcn.wait.asyncmark(i16 1)
  %lds_n_2 = sub i32 %n, 2
  %lds_gep_n_2 = getelementptr i32, ptr addrspace(3) %lds, i32 %lds_n_2
  %lds_val_n_2 = load i32, ptr addrspace(3) %lds_gep_n_2

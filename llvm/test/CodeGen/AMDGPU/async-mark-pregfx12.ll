  %lds_n_1 = sub i32 %n, 1
  %lds_gep_n_1 = getelementptr i32, ptr addrspace(3) %lds, i32 %lds_n_1
  %lds_val_n_1 = load i32, ptr addrspace(3) %lds_gep_n_1
  %sum_e3 = add i32 %cur_v, %cur_g
